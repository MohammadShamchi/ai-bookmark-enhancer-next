{
  "manifest_version": 3,
  "name": "AI Bookmark Enhancer",
  "version": "2.2.0",
  "description": "Organize your bookmarks intelligently with AI.",
  "permissions": ["bookmarks", "storage", "downloads", "tabs"],
  "host_permissions": ["https://api.openai.com/*"],
  "options_page": "ui/settings.html",
  "action": {
    "default_title": "AI Bookmark Enhancer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
